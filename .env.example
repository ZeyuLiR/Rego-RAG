# Copy to .env and fill in. Never commit .env.
# Which way the app reaches Claude:
#   claude-code  the Claude Code CLI on this machine, on the Claude plan it is logged in with
#                (no API key; for setup and the owner's own testing)
#   api          the Anthropic API (needs ANTHROPIC_API_KEY; use this once clerks use the system)
# If unset: api when ANTHROPIC_API_KEY is set, otherwise claude-code.
REGORAG_LLM_BACKEND=claude-code
ANTHROPIC_API_KEY=
# Models (defaults shown). Q&A uses the main model; bulk extraction can use a cheaper one.
REGORAG_QA_MODEL=claude-opus-5-5
REGORAG_EXTRACT_MODEL=claude-opus-5-5
REGORAG_QA_EFFORT=medium
# Hard monthly spend cap for API calls, in USD (Claude Code calls are not counted). 0 = no cap.
REGORAG_MONTHLY_BUDGET_USD=50
# Above this many (estimated) tokens per collection, switch from whole-KB context to retrieval.
REGORAG_FULL_CONTEXT_TOKEN_LIMIT=150000
# Protects the import and review page (/import). Leave empty only while the server runs on
# your own computer (127.0.0.1). Set it before clerks can reach the server.
REGORAG_ADMIN_TOKEN=
